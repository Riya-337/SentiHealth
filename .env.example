# Copy to .env (git-ignored). Everything is optional; the defaults are safe for a lab.

# Browsers may call the API only from these origins.
SENTIHEALTH_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173,http://localhost:4173

# 1 = record response actions without applying them (default). Set 0 only on a host with nftables
# where you have tested the rules.
SENTIHEALTH_DRY_RUN=1
SENTIHEALTH_BLOCK_TTL_MIN=240
# SENTIHEALTH_THROTTLE_IFACE=eth0
# Command templates for the directory ({user} is substituted). Leave unset to record only.
# SENTIHEALTH_LOCK_CMD=/usr/local/bin/ad-lock {user}
# SENTIHEALTH_UNLOCK_CMD=/usr/local/bin/ad-unlock {user}

# Sensors must sign events (default 1). The web app reads the key from this variable or the vault.
SENTIHEALTH_REQUIRE_SIGNED_EVENTS=1
# SENTIHEALTH_EVENT_KEY=<hex from scripts/export_sensor_key.py>

# Where the audit-chain anchors go: a path the sentinel host cannot rewrite.
# SENTIHEALTH_ANCHOR_FILE=/mnt/worm/sentihealth/anchors.jsonl

# Rules layer in the live scorer: 1 = deployed failed-login rules (default), expert = fuller thresholds, 0 = off.
SENTIHEALTH_RULES=1

# Accept the attack simulators' precomputed events (tabletop exercises, tests only).
SENTIHEALTH_TEST_MODE=0

# Optional tunnel for the Vercel-hosted frontend (demo only, not for a hospital network).
# NGROK_AUTHTOKEN=
# NGROK_DOMAIN=
