# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# Secrets — NEVER commit these
config/.chain_key
.env
*.env

# macOS
.DS_Store

# Runtime logs & data (generated at runtime)
logs/
data/snapshots/
data/audit_chain.json
data/audit_chain_backup.json
data/audit_chain_pre_hardening.json
data/audit_chain.json.tmp
retraining/retraining_queue.json
*.db

# Node / frontend build
webapp/node_modules/
frontend/node_modules/
frontend/dist/
frontend/.next/
frontend_backup.zip

# ML model backups (keep trained models, skip backups)
models/backup_*/

# Context / scratch
context/

# Cryptographic runtime secrets
config/pseudonym_salt.bin

# Runtime state (auto-generated, changes every run)
config/active_emergencies.json
config/badge_events.json

# Root-level runtime log files
logs_dashboard.txt
logs_frontend.txt
logs_sentinel.txt
logs_webapp.txt

# Secrets and per-install state: created on first run, never commit
config/.secrets_vault.json
config/certs/server.key
config/certs/server.crt
data/users.json
data/users.json.bak
data/.users.json.hmac
data/audit_chain_replica.json

# Generated by ml/simulate_events.py and ml/train.py (deterministic; re-create with the commands in README)
data/events_sim.jsonl.gz
data/features_sim.csv.gz
data/splits_sim.csv.gz
# Trained models are regenerated by `python3 ml/train.py` (deterministic, a few minutes); only the
# manifest, the feature spec and the decision policy are tracked.
models/*.pkl

# per-install state
data/anchors.jsonl
data/snoozes.json
models/archive/
models/registry.json

# Public datasets (downloaded by scripts/fetch_datasets.sh; licences on their own pages)
data/external/
