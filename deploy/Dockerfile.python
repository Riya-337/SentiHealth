FROM python:3.12-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl nftables && rm -rf /var/lib/apt/lists/*
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY _paths.py ./
COPY api ./api
COPY core ./core
COPY ml ./ml
COPY security ./security
COPY privacy ./privacy
COPY deception ./deception
COPY notifications ./notifications
COPY scripts ./scripts
COPY attack_scripts ./attack_scripts
COPY evaluation ./evaluation
# models, data, logs and config are bind-mounted at run time (see docker-compose.yml)
RUN mkdir -p data logs config models
ENV PYTHONUNBUFFERED=1
