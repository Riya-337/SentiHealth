FROM node:22-alpine
WORKDIR /app/webapp
COPY webapp/package.json webapp/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts
COPY webapp/app.js ./
# app.js writes to ../logs and reads ../config, relative to its own directory
RUN mkdir -p /app/logs /app/data /app/config
EXPOSE 3000
CMD ["node", "app.js"]
